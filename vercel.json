{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "gru1"
  ],
  "rewrites": [
    {
      "source": "/api/admin/products",
      "destination": "/api/admin/affiliates?__handler=she-products"
    },
    {
      "source": "/api/cart-config",
      "destination": "/api/affiliate/dashboard?__handler=she-cart-config"
    },
    {
      "source": "/api/admin/products",
      "destination": "/api/admin/affiliates?__handler=she-products"
    },
    {
      "source": "/api/cart-config",
      "destination": "/api/affiliate/dashboard?__handler=she-cart-config"
    },
    {
      "source": "/api/admin/products",
      "destination": "/api/admin/affiliates?__handler=she-products"
    },
    {
      "source": "/api/cart-config",
      "destination": "/api/affiliate/yampi-sync?__handler=she-cart-config"
    },
    {
      "source": "/api/webhooks/melhor-envio",
      "destination": "/api/webhooks/yampi?provider=melhor-envio"
    },
    {
      "source": "/api/melhor-envio/status",
      "destination": "/api/melhor-envio/authorize?__handler=status"
    },
    {
      "source": "/api/affiliate/track",
      "destination": "/api/affiliate/dashboard?__handler=track"
    },
    {
      "source": "/api/reseller/settings",
      "destination": "/api/affiliate/yampi-sync?__handler=reseller-settings"
    },
    {
      "source": "/api/admin/product-purchases",
      "destination": "/api/admin/affiliates?__handler=product-purchases&admin=1"
    },
    {
      "source": "/api/affiliate/product-purchases",
      "destination": "/api/affiliate/dashboard?__handler=product-purchases"
    },
    {
      "source": "/api/admin/data",
      "destination": "/api/admin/affiliates?__handler=admin-data"
    },
    {
      "source": "/api/webhooks/woovi",
      "destination": "/api/webhooks/yampi?provider=woovi"
    },
    {
      "source": "/api/affiliate/login",
      "destination": "/api/affiliate/auth?action=login"
    },
    {
      "source": "/api/affiliate/register",
      "destination": "/api/affiliate/auth?action=register"
    },
    {
      "source": "/api/affiliate/logout",
      "destination": "/api/affiliate/auth?action=logout"
    },
    {
      "source": "/api/affiliate/forgot-password",
      "destination": "/api/affiliate/auth?action=forgot"
    },
    {
      "source": "/api/affiliate/reset-password",
      "destination": "/api/affiliate/auth?action=reset"
    },
    {
      "source": "/api/affiliate/push-subscription",
      "destination": "/api/affiliate/auth?action=push-subscription"
    },
    {
      "source": "/((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ]
}
